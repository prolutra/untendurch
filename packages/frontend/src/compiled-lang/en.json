  "howto_modal_description": [
    {
      "type": 0,
      "value": "Follow these steps to properly document a bridge."
    }
  ],
  "howto_modal_step1_desc": [
    {
      "type": 0,
      "value": "Position the marker on the map exactly on the bridge. You can use the location feature to use your current GPS position, or manually move the marker to the correct position. Accurate positioning is important for documentation."
    }
  ],
  "howto_modal_step1_title": [
    {
      "type": 0,
      "value": "Mark location"
    }
  ],
  "howto_modal_step2_desc": [
    {
      "type": 0,
      "value": "Photograph the bridge frontally from the water side – from an otter's perspective. The photo should show the passage under the bridge. This helps us assess how accessible the passage is for otters."
    }
  ],
  "howto_modal_step2_title": [
    {
      "type": 0,
      "value": "Photo from otter's view"
    }
  ],
  "howto_modal_step3_desc": [
    {
      "type": 0,
      "value": "Estimate the bridge dimensions: width (span of the passage), height (from water level to bridge underside) and length/depth (how long is the passage). The bridge index (BI) is calculated from these measurements and helps to classify how otter-friendly a bridge is."
    }
  ],
  "howto_modal_step3_title": [
    {
      "type": 0,
      "value": "Estimate dimensions"
    }
  ],
  "howto_modal_step4_desc": [
    {
      "type": 0,
      "value": "Assess the bridge surroundings: Is there a continuous banquette (bank strip) of at least 30 cm width on one side? Are there stones protruding from the water that can serve as marking spots? Is the bank continuous before and after the bridge, or do animals need to cross the road? Are there obstacles like weirs or drops over 1 meter within 20 meters?"
    }
  ],
  "howto_modal_step4_title": [
    {
      "type": 0,
      "value": "Assess surroundings"
    }
  ],
  "howto_modal_step5_desc": [
    {
      "type": 0,
      "value": "Record the traffic situation: How many vehicles pass the bridge during your observation? What is the speed limit on the road? Are there barriers like fences or walls that could prevent animals from safely crossing the road? This data helps with risk assessment."
    }
  ],
  "howto_modal_step5_title": [
    {
      "type": 0,
      "value": "Record traffic"
    }
  ],
  "howto_modal_title": [
    {
