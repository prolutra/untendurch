    }
  ],
  "welcome_modal_feature_pins_desc": [
    {
      "type": 0,
      "value": "Die Pins zeigen erfasste Brücken. Die Farbe zeigt das Sicherheitsrisiko: Grün (fischotterfreundlich) bis Violett (sehr hohes Risiko). Tippen Sie auf einen Pin für Details."
    }
  ],
