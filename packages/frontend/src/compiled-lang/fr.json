  "howto_modal_description": [
    {
      "type": 0,
      "value": "Suivez ces étapes pour documenter correctement un pont."
    }
  ],
  "howto_modal_step1_desc": [
    {
      "type": 0,
      "value": "Placez le marqueur sur la carte exactement sur le pont. Vous pouvez utiliser la fonction de localisation pour utiliser votre position GPS actuelle, ou déplacer manuellement le marqueur vers la bonne position. Un positionnement précis est important pour la documentation."
    }
  ],
  "howto_modal_step1_title": [
    {
      "type": 0,
      "value": "Marquer l'emplacement"
    }
  ],
  "howto_modal_step2_desc": [
    {
      "type": 0,
      "value": "Photographiez le pont de face depuis le côté de l'eau – du point de vue d'une loutre. La photo doit montrer le passage sous le pont. Cela nous aide à évaluer l'accessibilité du passage pour les loutres."
    }
  ],
  "howto_modal_step2_title": [
    {
      "type": 0,
      "value": "Photo du point de vue de la loutre"
    }
  ],
  "howto_modal_step3_desc": [
    {
      "type": 0,
      "value": "Estimez les dimensions du pont: largeur (portée du passage), hauteur (du niveau de l'eau au dessous du pont) et longueur/profondeur (longueur du passage). L'indice du pont (IP) est calculé à partir de ces mesures et aide à évaluer si un pont est favorable aux loutres."
    }
  ],
  "howto_modal_step3_title": [
    {
      "type": 0,
      "value": "Estimer les dimensions"
    }
  ],
  "howto_modal_step4_desc": [
    {
      "type": 0,
      "value": "Évaluez les environs du pont: Y a-t-il une banquette continue (bande de rive) d'au moins 30 cm de largeur d'un côté? Y a-t-il des pierres dépassant de l'eau qui peuvent servir de points de repère? La rive est-elle continue avant et après le pont, ou les animaux doivent-ils traverser la route? Y a-t-il des obstacles comme des barrages ou des chutes de plus d'un mètre dans un rayon de 20 mètres?"
    }
  ],
  "howto_modal_step4_title": [
    {
      "type": 0,
      "value": "Évaluer les environs"
    }
  ],
  "howto_modal_step5_desc": [
    {
      "type": 0,
      "value": "Enregistrez la situation du trafic: Combien de véhicules passent le pont pendant votre observation? Quelle est la limite de vitesse sur la route? Y a-t-il des barrières comme des clôtures ou des murs qui pourraient empêcher les animaux de traverser la route en toute sécurité? Ces données aident à l'évaluation des risques."
    }
  ],
  "howto_modal_step5_title": [
    {
      "type": 0,
      "value": "Enregistrer le trafic"
    }
  ],
  "howto_modal_title": [
    {
      "type": 0,
      "value": "Comment signaler un pont"
    }
