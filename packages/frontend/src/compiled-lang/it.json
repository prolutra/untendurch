  "welcome_modal_description": [
    {
      "type": 0,
      "value": "Con questa app puoi registrare ponti in Svizzera e valutare la loro sicurezza per le lontre. L'indice del ponte (IP) aiuta a valutare quanto un ponte sia adatto alle lontre."
    }
  ],
  "welcome_modal_feature_clustering_desc": [
    {
      "type": 0,
      "value": "Con molti ponti, i marker vicini vengono raggruppati in cerchi con un numero. Ingrandisci per vedere i singoli ponti."
    }
  ],
  "welcome_modal_feature_clustering_title": [
    {
      "type": 0,
      "value": "Raggruppamento"
    }
  ],
  "welcome_modal_feature_filters_desc": [
    {
      "type": 0,
      "value": "Filtra i ponti per rischio di sicurezza o cantone. Nelle opzioni di visualizzazione puoi attivare o disattivare il raggruppamento e scegliere lo stile della mappa."
    }
  ],
  "welcome_modal_feature_filters_title": [
